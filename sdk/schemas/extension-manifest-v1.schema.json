{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://horo.dev/schemas/extension-manifest-v1.schema.json",
  "title": "Horo Extension Manifest V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "version", "modules"],
  "properties": {
    "schemaVersion": {"const": 1},
    "id": {"$ref": "#/$defs/id"},
    "version": {"$ref": "#/$defs/version"},
    "kind": {"$ref": "#/$defs/token"},
    "displayName": {"type": "string", "maxLength": 4096},
    "description": {"type": "string", "maxLength": 4096},
    "author": {"type": "string", "maxLength": 4096},
    "compatibility": {"$ref": "#/$defs/compatibility"},
    "modules": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {"$ref": "#/$defs/module"}
    },
    "contributions": {
      "type": "array",
      "maxItems": 256,
      "items": {"$ref": "#/$defs/contribution"}
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "maxLength": 256,
      "pattern": "^[a-z](?:[a-z0-9-]*[a-z0-9])?(?:\\.[a-z](?:[a-z0-9-]*[a-z0-9])?)*$"
    },
    "token": {
      "type": "string",
      "maxLength": 256,
      "pattern": "^[a-z0-9-][a-z0-9_-]*[a-z0-9-]$|^[a-z0-9-]$"
    },
    "version": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "engineMin": {"$ref": "#/$defs/version"},
        "engineMax": {"$ref": "#/$defs/version"},
        "sdkAbi": {"$ref": "#/$defs/id"},
        "platforms": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/token"}
        }
      }
    },
    "abi": {
      "type": "object",
      "additionalProperties": false,
      "required": ["major", "minimumMinor"],
      "properties": {
        "major": {"type": "integer", "minimum": 1, "maximum": 4294967295},
        "minimumMinor": {"type": "integer", "minimum": 0, "maximum": 4294967295}
      }
    },
    "nativeEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["platform", "architecture", "buildProfile", "entry"],
      "properties": {
        "platform": {"enum": ["windows", "macos", "linux"]},
        "architecture": {"enum": ["x86_64", "arm64"]},
        "buildProfile": {"enum": ["debug", "release"]},
        "entry": {"type": "string", "minLength": 1, "maxLength": 512}
      }
    },
    "serviceExport": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "contract", "version"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "contract": {"$ref": "#/$defs/id"},
        "version": {"$ref": "#/$defs/version"}
      }
    },
    "serviceImport": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "service", "contract", "minimumVersion"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "service": {"$ref": "#/$defs/id"},
        "contract": {"$ref": "#/$defs/id"},
        "minimumVersion": {"$ref": "#/$defs/version"}
      }
    },
    "module": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "kind"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "version": {"$ref": "#/$defs/version"},
        "kind": {"$ref": "#/$defs/token"},
        "entry": {"type": "string", "minLength": 1, "maxLength": 512},
        "roles": {
          "type": "array",
          "minItems": 1,
          "maxItems": 5,
          "uniqueItems": true,
          "items": {
            "enum": [
              "backend-capability",
              "editor-presentation",
              "headless-tooling",
              "script-provider",
              "runtime-participant"
            ]
          }
        },
        "dependencies": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/id"}
        },
        "exports": {
          "type": "array",
          "maxItems": 256,
          "items": {"$ref": "#/$defs/serviceExport"}
        },
        "imports": {
          "type": "array",
          "maxItems": 256,
          "items": {"$ref": "#/$defs/serviceImport"}
        },
        "abi": {"$ref": "#/$defs/abi"},
        "entries": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {"$ref": "#/$defs/nativeEntry"}
        },
        "requiredCapabilities": {
          "type": "array",
          "maxItems": 256,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/id"}
        }
      },
      "not": {"required": ["entry", "entries"]}
    },
    "contribution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id", "module"],
      "properties": {
        "type": {"$ref": "#/$defs/id"},
        "id": {"$ref": "#/$defs/id"},
        "module": {"$ref": "#/$defs/id"}
      }
    }
  }
}
