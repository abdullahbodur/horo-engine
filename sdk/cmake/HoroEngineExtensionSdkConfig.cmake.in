@PACKAGE_INIT@

set(HORO_EXTENSION_SDK_VERSION "@HORO_EXTENSION_SDK_VERSION@")
set(HORO_EXTENSION_ABI_MAJOR_VERSION @HORO_EXTENSION_ABI_MAJOR_VERSION@)
set(HORO_EXTENSION_ABI_PUBLISHED_MINOR @HORO_EXTENSION_ABI_PUBLISHED_MINOR@)
set(HORO_EXTENSION_ABI_MIN_HOST_MINOR @HORO_EXTENSION_ABI_MIN_HOST_MINOR@)
set(HORO_EXTENSION_ABI_MAX_HOST_MAJOR_EXCLUSIVE
    @HORO_EXTENSION_ABI_MAX_HOST_MAJOR_EXCLUSIVE@)
set(HORO_EXTENSION_SDK_METADATA
    "${PACKAGE_PREFIX_DIR}/share/horo/extension-sdk/extension-sdk.json")

if(NOT EXISTS "${PACKAGE_PREFIX_DIR}/include/Horo/Extensions/ExtensionAbi.h")
    set(HoroEngineExtensionSdk_FOUND FALSE)
    set(HoroEngineExtensionSdk_NOT_FOUND_MESSAGE
        "The Horo extension SDK package is missing ExtensionAbi.h")
    return()
endif()

if(NOT TARGET HoroEngine::ExtensionSdk)
    add_library(HoroEngine::ExtensionSdk INTERFACE IMPORTED)
    set_target_properties(HoroEngine::ExtensionSdk PROPERTIES
        INTERFACE_INCLUDE_DIRECTORIES "${PACKAGE_PREFIX_DIR}/include"
        INTERFACE_COMPILE_DEFINITIONS
            "HORO_EXTENSION_SDK_ABI_MAJOR=@HORO_EXTENSION_ABI_MAJOR_VERSION@;HORO_EXTENSION_SDK_ABI_PUBLISHED_MINOR=@HORO_EXTENSION_ABI_PUBLISHED_MINOR@;HORO_EXTENSION_SDK_ABI_MIN_HOST_MINOR=@HORO_EXTENSION_ABI_MIN_HOST_MINOR@;HORO_EXTENSION_SDK_ABI_MAX_HOST_MAJOR_EXCLUSIVE=@HORO_EXTENSION_ABI_MAX_HOST_MAJOR_EXCLUSIVE@")
endif()

check_required_components(HoroEngineExtensionSdk)
